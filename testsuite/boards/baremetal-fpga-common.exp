set_board_info env,preferred_timeout 15
set_board_info env,resume_timeout 1
set_board_info env,exec_timeout 2

proc jtag_tool_tap_definition_flags { tap_config { speed 500 } } {
  global testsuitedir
  return [list \
    -f "$testsuitedir/boards/support/ocd/$tap_config" \
    -c "transport select jtag" \
    -c "adapter speed $speed"
  ]
}
