ocd_connect

set targets_num [ocdtlb_rsp_get [ocdtlb_run_expect "targets"] targets_num]
set expected_num [target_info cpu,cores_num]

if {![expr { $expected_num == $targets_num}] } {
  perror "unexpected number of targets $targets_num, expecting $expected_num"
  return [ocd_test_fail]
}

return [ocd_test_pass]

