proc run_test {} {
  set script_to_run "[ocdtlb_test_resource_path run_script_ebreak_ctrl.tcl]"
  set LogFile [utils_spawn_universal_launcher \
    [list \
      --disable-ebreak \
      --run-script $script_to_run \
      --run-command "check_ebreak_disabled" \
    ] \
    ebreak_disabled \
    expect_success]

  set termination_policy expect_success
  if {![target_info cpu,dcsr_ebreakx_warl]} {
    set termination_policy expect_failure
  }

  set has_u_mode [target_info cpu,has_u_mode]
  set has_s_mode [target_info cpu,has_s_mode]

  set LogFile [utils_spawn_universal_launcher \
    [list \
      --run-script $script_to_run \
      --run-command "check_ebreak_enabled $has_u_mode $has_s_mode" \
    ] \
    ebreak_enabled \
    $termination_policy]

  return [ocd_test_pass]
}

return [run_test]
