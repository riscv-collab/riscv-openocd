proc run_test {} {
    global taps_info

    jtag_connect

    ocdjtag_riscv_reset_hart 0

    if {[ocdjtag_riscv_halt_hart 0] == 0} {
        return [ocd_test_fail]
    }

    if {[ocdjtag_riscv_resume_hart 0] == 0} {
        return [ocd_test_fail]
    }

    return [ocd_test_pass]
}

return [run_test]
