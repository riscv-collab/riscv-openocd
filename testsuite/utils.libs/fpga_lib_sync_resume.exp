proc run_test {} {
  set LogFile [utils_spawn_universal_launcher \
    [list \
      --verbose \
      --run-script [ocdtlb_test_resource_path fpga_lib_sync_resume_test.tcl] \
      --run-command run_test
    ] \
    fpga_lib_sync_resume_test \
    expect_success]

  return [ocd_test_pass]
}

return [run_test]

